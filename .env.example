# ---------------------------------------------------------------------------
# AI Newsletter Agent - example environment file
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux / macOS)
#
# NEVER commit the real .env file - it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- OpenRouter (REQUIRED) --------------------------------------------------
# Create a key at https://openrouter.ai/keys and paste it here AFTER copying
# this file:  .env.example -> .env   (.env is git-ignored; this file is NOT,
# so never put a real key in it).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OWN_KEY

# Model slug. "openrouter/free" routes to a free model, so the agent can be
# demonstrated without paid LLM usage. Any OpenRouter slug works, e.g.
#   OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=openrouter/free

# Optional comma separated list of models that are tried when the configured
# model does not support JSON-schema structured output or is rate limited.
# Leave empty to only use OPENROUTER_MODEL.
OPENROUTER_FALLBACK_MODELS=

# Optional OpenRouter attribution headers (shown in the OpenRouter dashboard)
OPENROUTER_APP_URL=https://github.com/your-user/ai-newsletter-agent
OPENROUTER_APP_NAME=AI Newsletter Agent

# Ask OpenRouter to only route to providers that support the requested
# parameters (e.g. structured outputs). Set to true if you see provider errors.
OPENROUTER_REQUIRE_PARAMETERS=false

# Enable OpenRouter's response-healing plugin for JSON repairs.
OPENROUTER_RESPONSE_HEALING=false

# --- LLM behaviour ----------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=2

# --- Agent behaviour --------------------------------------------------------
# Hard limit for the critic/revision loop
MAX_REVISIONS=2
# Default number of articles inside the newsletter (the goal can override it)
TARGET_ARTICLES=6
# How many candidate articles the research tool collects before evaluation
MAX_ARTICLES_TO_COLLECT=24
# Only consider articles published within this many days (0 = no limit)
RECENCY_WINDOW_DAYS=14
# Batch size when evaluating/summarizing with the LLM
EVALUATION_BATCH_SIZE=6

# --- Research tool ----------------------------------------------------------
# Maximum number of feeds that are queried per run
RESEARCH_MAX_SOURCES=8
# Maximum number of articles taken from a single feed
MAX_ITEMS_PER_SOURCE=25
# Download + extract the full article text with news-please for the top N
# candidates (0 disables full-text extraction)
ENRICH_ARTICLE_LIMIT=12
RESEARCH_MAX_WORKERS=4
REQUEST_TIMEOUT_SECONDS=20
# Large articles are truncated before being sent to the LLM
MAX_CONTENT_CHARS=6000

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional path overrides (defaults: ./config/sources.yaml and ./outputs)
# SOURCES_PATH=config/sources.yaml
# OUTPUTS_DIR=outputs